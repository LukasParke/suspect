{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suspect:editor-native-host:pins:v1",
  "title": "Immutable inputs for the Suspect native VS Code host runner",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "cli", "vscode", "tools", "extension"],
  "properties": {
    "format": { "const": "suspect.editor.native-host.pins.v1" },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "expectedProfiles"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "expectedProfiles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": ["typescript-http", "rust-http", "python-http", "go-http", "swift-http", "ruby-http", "csharp-http", "java-http", "kotlin-http", "php-http", "dart-http", "cpp-http"]
          },
          "allOf": [
            { "contains": { "const": "typescript-http" } },
            { "contains": { "const": "rust-http" } },
            { "contains": { "const": "python-http" } }
          ],
          "description": "Exact advertised backend ID set, independent of order. The full SDK runner must supply all twelve IDs."
        }
      }
    },
    "vscode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "executableSha256", "archive", "archiveSha256", "version", "commit", "platform"],
      "properties": {
        "executable": { "$ref": "#/$defs/path" },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "archive": { "$ref": "#/$defs/path" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.-]+)?$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "platform": { "enum": ["darwin-arm64", "darwin-x64", "linux-x64", "linux-arm64"] }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "lockSha256"],
      "properties": {
        "directory": { "$ref": "#/$defs/path" },
        "lockSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDirectory", "sourceSha256"],
      "properties": {
        "sourceDirectory": { "$ref": "#/$defs/path" },
        "sourceSha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 returned by contract.cjs sourceIdentity(sourceDirectory), covering package.json, package-lock.json, src/, dist/ and media/."
        },
        "vsix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/path" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "Absolute local path on the launching host; existence, kind, containment and hashes are checked by the runner."
    }
  }
}
