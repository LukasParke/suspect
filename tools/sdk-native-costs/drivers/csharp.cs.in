                Check(response.Status == 200);
                Checked(response.Data);
            }
            Console.WriteLine($"SUSPECT_NATIVE_COSTS {{\"phase\":\"request\",\"iterations\":{count},\"precision\":\"@@PRECISION@@\"}}");
        }
        else throw new Exception("unknown phase");
