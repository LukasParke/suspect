package main

import (
    "context"
    "fmt"
    "os"
    "strconv"
    "strings"
    "time"
    sdk "@@PACKAGE@@"
)

func check(value bool) { if !value { panic("native SDK observation assertion") } }
func checked(value sdk.@@MODEL@@) {
    check(value.Data.TotalCredits.String() == "@@PRECISION@@")
    check(value.Data.TotalUsage.String() == "25.75")
}
func main() {
    phase := os.Args[1]
    count, err := strconv.Atoi(os.Args[2]); if err != nil { panic(err) }
    fixture := []byte(@@FIXTURE@@)
    switch phase {
    case "import":
        check(count == 1)
        check(fmt.Sprintf("%T", sdk.Codecs.@@CODEC@@) != "")
        fmt.Println(`SUSPECT_NATIVE_COSTS {"phase":"import","iterations":1,"loaded":true}`)
    case "codec":
        encodedBytes := 0
        for i := 0; i < count; i++ {
            value, err := sdk.Codecs.@@CODEC@@.Decode(fixture); if err != nil { panic(err) }
            checked(value)
            encoded, err := sdk.Codecs.@@CODEC@@.Encode(value); if err != nil { panic(err) }
            check(strings.Contains(string(encoded), `"total_credits":@@PRECISION@@`))
            encodedBytes += len(encoded)
        }
        fmt.Printf("SUSPECT_NATIVE_COSTS {\"phase\":\"codec\",\"iterations\":%d,\"encodedBytes\":%d,\"precision\":\"@@PRECISION@@\"}\n", count, encodedBytes)
    case "request":
        base := os.Args[3]
        check(strings.HasPrefix(base, "http://127.0.0.1:") && strings.HasSuffix(base, "/api/v1"))
        client, err := sdk.NewClient(sdk.@@CREDENTIAL@@("@@TOKEN@@"), sdk.ClientOptions{ServerURL: base}); if err != nil { panic(err) }
        defer client.CloseIdleConnections()
        ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second); defer cancel()
        for i := 0; i < count; i++ {
            response, err := client.@@METHOD@@(ctx, sdk.@@INPUTCONSTRUCTOR@@()); if err != nil { panic(err) }
            typed := response.(sdk.@@RESPONSETYPE@@)
            checked(typed.Data)
        }
        fmt.Printf("SUSPECT_NATIVE_COSTS {\"phase\":\"request\",\"iterations\":%d,\"precision\":\"@@PRECISION@@\"}\n", count)
    default: panic("unknown phase")
    }
}
