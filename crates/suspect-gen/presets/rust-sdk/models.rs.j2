// Generated model structs for {{ title }} {{ version }}.
// Included from lib.rs; compiled together by a single rustc invocation.
{%- for s in schemas %}
{% set def = s.json %}

{%- if def.type == "object" %}
{% set reqs = def.required or [] %}

pub struct {{ s.name | PascalCase }} {
    {%- for pname in def.properties %}
    {%- set prop = def.properties[pname] %}
    {%- set rt = prop | rust_type %}
    pub {{ pname | snake_case }}: {% if pname in reqs %}{% if prop["$ref"] %}Box<{{ rt }}>{% else %}{{ rt }}{% endif %}{% else %}{% if prop["$ref"] %}Option<Box<{{ rt }}>>{% else %}{{ rt if rt is startingwith("Option<") else "Option<" ~ rt ~ ">" }}{% endif %}{% endif %},
    {%- endfor %}
}
{%- else %}

pub type {{ s.name | PascalCase }} = {{ def | rust_type }};
{%- endif %}
{%- endfor %}
