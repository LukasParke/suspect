[
  {
    "name":"strict-tree",
    "schemas":{
      "Tree":{"$id":"urn:tree","$dynamicAnchor":"node","type":"object","properties":{"data":true,"children":{"type":"array","items":{"$dynamicRef":"#node"}}}},
      "Strict":{"$id":"urn:strict","$dynamicAnchor":"node","$ref":"urn:tree","unevaluatedProperties":false},
      "Inactive":{"$id":"urn:inactive","$dynamicAnchor":"node","not":{}}
    },
    "cases":[
      {"root":"Strict","extraRoots":["Inactive"],"data":{"data":"root","children":[{"data":"child"}]},"expected":"Valid"},
      {"root":"Strict","data":{"children":[{"unexpected":1}]},"expected":"Invalid","source":"Strict/unevaluatedProperties","path":"/children/0/unexpected"},
      {"root":"Tree","data":{"children":[{"unexpected":1}]},"expected":"Valid"}
    ]
  },
  {
    "name":"outermost",
    "schemas":{
      "Base":{"$id":"urn:base","$dynamicAnchor":"node","properties":{"outer":true,"middle":true,"children":{"items":{"$dynamicRef":"#node"}}}},
      "Middle":{"$id":"urn:middle","$dynamicAnchor":"node","$ref":"urn:base","required":["middle"]},
      "Outer":{"$id":"urn:outer","$dynamicAnchor":"node","$ref":"urn:middle","required":["outer"]},
      "Inactive":{"$id":"urn:aaa","$dynamicAnchor":"node","not":{}}
    },
    "cases":[
      {"root":"Outer","extraRoots":["Inactive"],"data":{"outer":true,"middle":true,"children":[{"outer":true,"middle":true}]},"expected":"Valid"},
      {"root":"Outer","data":{"outer":true,"middle":true,"children":[{"middle":true}]},"expected":"Invalid","source":"Outer/required","path":"/children/0"}
    ]
  },
  {
    "name":"fresh-context-and-trials",
    "schemas":{
      "Fallback":{"$id":"urn:fallback","$dynamicAnchor":"flag","not":{}},
      "Reenter":{"$id":"urn:reenter","if":{"$dynamicRef":"urn:fallback#flag"},"then":true,"else":{"$ref":"urn:new-context"}},
      "NewContext":{"$id":"urn:new-context","$defs":{"flag":{"$dynamicAnchor":"flag"}},"$ref":"urn:reenter"},
      "Plain":{"$id":"urn:plain","$dynamicAnchor":"node","type":"string"},
      "Failed":{"$id":"urn:failed","$dynamicAnchor":"node","not":{}},
      "Integer":{"$id":"urn:integer","$dynamicAnchor":"node","type":"integer"},
      "Trial":{"$id":"urn:trial","anyOf":[{"$ref":"urn:failed"},{"$dynamicRef":"urn:plain#node"}]},
      "UniqueTrial":{"$id":"urn:unique","oneOf":[{"$ref":"urn:integer"},{"$dynamicRef":"urn:plain#node"}]},
      "Cycle":{"$id":"urn:cycle","$dynamicAnchor":"node","$dynamicRef":"#node"}
    },
    "cases":[
      {"root":"Reenter","data":7,"expected":"Valid"},
      {"root":"Trial","data":"string","expected":"Valid"},
      {"root":"Trial","data":7,"expected":"Invalid","source":"Trial/anyOf","path":""},
      {"root":"UniqueTrial","data":7,"expected":"Valid"},
      {"root":"UniqueTrial","data":"string","expected":"Valid"},
      {"root":"Cycle","data":null,"expected":"EvaluationFailure","source":"Cycle","path":""}
    ]
  },
  {
    "name":"fallback-modes",
    "schemas":{
      "Base":{"$id":"urn:base","type":"string","$defs":{"Target":{"$dynamicAnchor":"node","$anchor":"plain","type":"string"}}},
      "Outer":{"$id":"urn:outer","$defs":{"Override":{"$dynamicAnchor":"node","type":"integer"}},"properties":{
        "dynamic":{"$dynamicRef":"urn:base#node"},"encoded":{"$dynamicRef":"urn:base#n%6fde"},
        "pointer":{"$dynamicRef":"urn:base#/$defs/Target"},"plain":{"$dynamicRef":"urn:base#plain"},
        "empty":{"$dynamicRef":"urn:base#"},"static":{"$ref":"urn:base#node"}
      }}
    },
    "cases":[
      {"root":"Outer","data":{"dynamic":1,"encoded":2,"pointer":"s","plain":"s","empty":"s","static":"s"},"expected":"Valid"},
      {"root":"Outer","data":{"dynamic":"s"},"expected":"Invalid","source":"Outer/$defs/Override/type","path":"/dynamic"},
      {"root":"Outer","data":{"pointer":1},"expected":"Invalid","source":"Base/$defs/Target/type","path":"/pointer"},
      {"root":"Outer","data":{"plain":1},"expected":"Invalid","source":"Base/$defs/Target/type","path":"/plain"},
      {"root":"Outer","data":{"empty":1},"expected":"Invalid","source":"Base/type","path":"/empty"},
      {"root":"Outer","data":{"static":1},"expected":"Invalid","source":"Base/$defs/Target/type","path":"/static"}
    ]
  },
  {
    "name":"do-not-enter-fallback",
    "schemas":{
      "Owner":{"$id":"urn:owner","$defs":{"Node":{"$dynamicAnchor":"node","$ref":"urn:follow"}},"$ref":"urn:use"},
      "Use":{"$id":"urn:use","$dynamicRef":"urn:fallback#node"},
      "Fallback":{"$id":"urn:fallback","$defs":{"Node":{"$dynamicAnchor":"node","type":"string"},"Other":{"$dynamicAnchor":"other","type":"integer"}}},
      "Follow":{"$id":"urn:follow","$dynamicRef":"urn:other#other"},
      "Other":{"$id":"urn:other","$dynamicAnchor":"other","type":"string"}
    },
    "cases":[
      {"root":"Owner","data":"s","expected":"Valid"},
      {"root":"Owner","data":7,"expected":"Invalid","source":"Other/type","path":""}
    ]
  },
  {
    "name":"nested-entry",
    "schemas":{
      "Outer":{"$id":"urn:outer","const":false,"$defs":{"Binding":{"$dynamicAnchor":"node","$ref":"urn:integer"},"Start":{"$ref":"urn:base#/$defs/Use"}}},
      "Base":{"$id":"urn:base","$defs":{"Node":{"$dynamicAnchor":"node","type":"string"},"Use":{"$dynamicRef":"#node"}}},
      "Integer":{"$id":"urn:integer","type":"integer"}
    },
    "cases":[
      {"root":"Outer/$defs/Start","data":7,"expected":"Valid"},
      {"root":"Outer/$defs/Start","data":"s","expected":"Invalid","source":"Integer/type","path":""}
    ]
  },
  {
    "name":"work-and-failures",
    "schemas":{
      "Entry":{"$id":"urn:entry","type":"string"},
      "Dynamic":{"$id":"urn:dynamic","$dynamicRef":"#node","$defs":{"Node":{"$dynamicAnchor":"node","type":"string"}}},
      "Scan":{"$id":"urn:scan","$dynamicRef":"#node","$defs":{"A":{"$dynamicAnchor":"a"},"Node":{"$dynamicAnchor":"node","type":"string"}}},
      "Ref":{"$id":"urn:ref","$ref":"urn:entry"},
      "Any":{"$id":"urn:any","anyOf":[true,{"$ref":"urn:number"}]},
      "Number":{"$id":"urn:number","maximum":0}
    },
    "cases":[
      {"root":"Entry","data":"s","limits":{"maxEvaluationSteps":3},"expected":"Valid"},
      {"root":"Entry","data":"s","limits":{"maxEvaluationSteps":2},"expected":"EvaluationFailure","source":"Entry/type","path":""},
      {"root":"Dynamic","data":"s","limits":{"maxEvaluationSteps":7},"expected":"Valid"},
      {"root":"Dynamic","data":"s","limits":{"maxEvaluationSteps":6},"expected":"EvaluationFailure","source":"Dynamic/$defs/Node/type","path":""},
      {"root":"Scan","data":"s","limits":{"maxEvaluationSteps":8},"expected":"Valid"},
      {"root":"Scan","data":"s","limits":{"maxEvaluationSteps":7},"expected":"EvaluationFailure","source":"Scan/$defs/Node/type","path":""},
      {"root":"Ref","data":"s","limits":{"maxEvaluationSteps":6},"expected":"Valid"},
      {"root":"Ref","data":"s","limits":{"maxEvaluationSteps":5},"expected":"EvaluationFailure","source":"Entry/type","path":""},
      {"root":"Any","data":12345,"limits":{"maxNumberBytes":3},"expected":"EvaluationFailure","source":"Number/maximum","path":""}
    ]
  }
]
