{
  "openapi":"3.2.0","info":{"title":"Kotlin env policy","version":"1"},
  "servers":[{"url":"https://source.example/api/v1"}],"security":[],
  "components":{
    "securitySchemes":{
      "apiKey":{"type":"http","scheme":"bearer"},
      "headerKey":{"type":"apiKey","in":"header","name":"X-Key"},
      "queryKey":{"type":"apiKey","in":"query","name":"key"},
      "cookieKey":{"type":"apiKey","in":"cookie","name":"session"},
      "aliasA":{"$ref":"#/components/securitySchemes/apiKey"},
      "aliasB":{"$ref":"#/components/securitySchemes/apiKey"},
      "basic":{"type":"http","scheme":"basic"},
      "oauth":{"type":"oauth2","flows":{"clientCredentials":{"tokenUrl":"https://id.example/token","scopes":{}}}}
    },
    "schemas":{"CredentialEnvironment":{"type":"object","required":["label"],"properties":{"label":{"type":"string","example":"model"}}}}
  },
  "paths":{
    "/anonymous":{"get":{"operationId":"anonymous","responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/protected":{"get":{"operationId":"protectedCall","security":[{"apiKey":[]}],"responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/and":{"get":{"operationId":"conjunction","security":[{"apiKey":[],"headerKey":[]}],"responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/or":{"get":{"operationId":"alternatives","security":[{"apiKey":[]},{"headerKey":[]},{}],"responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/query":{"get":{"operationId":"query","security":[{"queryKey":[]}],"responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/cookie":{"get":{"operationId":"cookie","security":[{"cookieKey":[]}],"responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/alias-a":{"get":{"operationId":"aliasA","security":[{"aliasA":[]}],"responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/alias-b":{"get":{"operationId":"aliasB","security":[{"aliasB":[]}],"responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/from-env":{"get":{"operationId":"fromEnv","responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/reserved":{"get":{"operationId":"reserved","responses":{"200":{"description":"model","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CredentialEnvironment"}}}}}}},
    "/basic":{"get":{"operationId":"basicCall","security":[{"basic":[]}],"responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}},
    "/oauth":{"get":{"operationId":"oauthCall","security":[{"oauth":[]}],"responses":{"200":{"description":"ok","content":{"application/json":{"schema":{"type":"string","example":"ok"}}}}}}}
  }
}
