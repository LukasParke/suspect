{
  "openapi":"3.2.0",
  "info":{"title":"Ruby credential environment controls","version":"1"},
  "servers":[{"url":"https://credentials.ruby.test/api/v1"}],
  "components":{"securitySchemes":{
    "apiKey":{"type":"http","scheme":"bearer"},
    "otherBearer":{"type":"http","scheme":"bearer"},
    "headerKey":{"type":"apiKey","in":"header","name":"X-API-Key"},
    "queryKey":{"type":"apiKey","in":"query","name":"api_key"},
    "cookieKey":{"type":"apiKey","in":"cookie","name":"session"},
    "basic":{"type":"http","scheme":"basic"},
    "oauth":{"type":"oauth2","flows":{"clientCredentials":{"tokenUrl":"./token","scopes":{"read":"Read"}}}},
    "oidc":{"type":"openIdConnect","openIdConnectUrl":"./.well-known/openid-configuration"}
  }},
  "paths":{
    "/bearer":{"get":{"operationId":"useBearer","security":[{"apiKey":[]}],"responses":{"204":{"description":"Done"}}}},
    "/other":{"get":{"operationId":"useOtherBearer","security":[{"otherBearer":[]}],"responses":{"204":{"description":"Done"}}}},
    "/header":{"get":{"operationId":"useHeaderKey","security":[{"headerKey":[]}],"responses":{"204":{"description":"Done"}}}},
    "/query":{"get":{"operationId":"useQueryKey","security":[{"queryKey":[]}],"responses":{"204":{"description":"Done"}}}},
    "/cookie":{"get":{"operationId":"useCookieKey","security":[{"cookieKey":[]}],"responses":{"204":{"description":"Done"}}}},
    "/choice":{"get":{"operationId":"chooseCredential","security":[{"apiKey":[]},{"headerKey":[]},{}],"responses":{"204":{"description":"Done"}}}},
    "/both":{"get":{"operationId":"useBoth","security":[{"apiKey":[],"headerKey":[]}],"responses":{"204":{"description":"Done"}}}},
    "/anonymous":{"get":{"operationId":"snapshot","security":[],"responses":{"204":{"description":"Anonymous"}}}},
    "/names":{"get":{"operationId":"envBindings","security":[],"responses":{"204":{"description":"Name collision control"}}}},
    "/basic":{"get":{"operationId":"useBasic","security":[{"basic":[]}],"responses":{"204":{"description":"Done"}}}},
    "/oauth":{"get":{"operationId":"useOAuth","security":[{"oauth":["read"]}],"responses":{"204":{"description":"Done"}}}},
    "/oidc":{"get":{"operationId":"useOidc","security":[{"oidc":["openid"]}],"responses":{"204":{"description":"Done"}}}}
  }
}
