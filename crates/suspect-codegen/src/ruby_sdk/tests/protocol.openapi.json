    "/conflict":{"get":{"operationId":"conflict","security":[{"token":[],"basic":[]}],"responses":{"200":{}}}},
    "/servers":{"get":{"operationId":"serverProbe","servers":[{"url":"https://{tenant}.example.test:{port}/{basePath}","name":"tenant","variables":{"tenant":{"default":"demo"},"port":{"default":"443","enum":["443","8443"]},"basePath":{"default":"v2"}}},{"url":"../relative","name":"relative"}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Reply"}}}}}}},
    "/choices":{"post":{"operationId":"choices","requestBody":{"required":true,"content":{
      "application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"type":"string"}},"additionalProperties":false},"example":{"name":"sample"}},
      "text/plain":{"schema":{"type":"string"}},
      "application/octet-stream":{"schema":{"maxLength":64}},
      "application/*":{},"*/*":{}
    }},"responses":{
      "200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Reply"}},"application/json;profile=v2":{"schema":{"$ref":"#/components/schemas/Reply"}},"application/problem+json":{"schema":{"type":"object","required":["message"],"properties":{"message":{"type":"string"}}}},"text/plain":{"schema":{"type":"string"}},"application/*":{},"*/*":{}}},
      "204":{"content":{"application/json":{"schema":{"type":"object","required":["never"]}}}},
      "2XX":{"content":{"text/plain":{"schema":{"type":"string"}}}},
      "default":{}
    }}},
    "/default":{"get":{"operationId":"defaultProbe","responses":{"default":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Reply"}}}}}}},
    "/headers":{"get":{"operationId":"readHeaders","responses":{"200":{
      "headers":{"X-Count":{"required":true,"schema":{"type":"integer","minimum":1}},"X-List":{"schema":{"type":"array","items":{"type":"integer"}}},"X-Map":{"explode":true,"schema":{"type":"object","properties":{"a":{"type":"integer"},"b":{"type":"string"}},"additionalProperties":false}},"Set-Cookie":{"schema":{"type":"array","items":{"type":"string"}}},"X-Optional":{"schema":{"type":"string"}}},
      "links":{"again":{"operationId":"readHeaders","parameters":{"query":"$response.header.X-Count"},"requestBody":{"$ref":"literal-instance-value","schema":{"type":"integer"}},"description":"Metadata only"}},
      "content":{"application/json":{"schema":{"$ref":"#/components/schemas/Reply"}}}
    }}}},
    "/none":{"head":{"operationId":"headProbe","responses":{"200":{"headers":{"X-Count":{"required":true,"schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"type":"object","required":["never"]}}}}}}},
    "/raw":{"get":{"operationId":"rawProbe","responses":{"200":{},"204":{}}}},
    "/upload":{"post":{"operationId":"upload","requestBody":{"required":true,"content":{"multipart/form-data":{
      "schema":{"type":"object","required":["file","metadata"],"additionalProperties":false,"minProperties":2,"maxProperties":4,"properties":{"file":{},"metadata":{"type":"object","required":["title"],"properties":{"title":{"type":"string"}},"additionalProperties":false},"labels":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"string"}},"files":{"type":"array","items":{}}}},
      "encoding":{"file":{"contentType":"image/png, image/jpeg","headers":{"X-Part-Id":{"required":true,"schema":{"type":"string"}}}},"metadata":{"contentType":"application/json"},"files":{"contentType":"application/octet-stream"}}
    }}},"responses":{"204":{}}}},
    "/form":{"post":{"operationId":"submitForm","requestBody":{"required":true,"content":{"application/x-www-form-urlencoded":{
      "schema":{"type":"object","required":["id"],"additionalProperties":false,"properties":{"id":{"type":"string"},"enabled":{"type":"boolean"},"address":{"type":"object","required":["city"],"properties":{"city":{"type":"string"}},"additionalProperties":false},"tags":{"type":"array","items":{"type":"string"}},"codes":{"type":"array","items":{"type":"integer"}}}},"encoding":{"codes":{"style":"form","explode":false}}
    }}},"responses":{"204":{}}}},
    "/whole-query":{"get":{"operationId":"wholeQuery","parameters":[{"name":"complete","in":"querystring","required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"a":{"type":"integer"}},"additionalProperties":false}}}}],"responses":{"200":{}}}},
    "/whole-form":{"get":{"operationId":"wholeForm","parameters":[{"name":"complete","in":"querystring","required":true,"content":{"application/x-www-form-urlencoded":{"schema":{"type":"object","required":["foo","bar"],"properties":{"foo":{"type":"string"},"bar":{"type":"boolean"},"items":{"type":"array","items":{"type":"integer"}}},"additionalProperties":false}}}}],"responses":{"200":{}}}},
    "/events":{"get":{"operationId":"events","responses":{"200":{"content":{"text/event-stream":{"itemSchema":{"$ref":"#/components/schemas/Event"}}}}}}},
    "/lines":{"get":{"operationId":"lines","responses":{"200":{"content":{"application/x-ndjson":{"itemSchema":{"$ref":"#/components/schemas/Line"}}}}}}},
    "/send-lines":{"post":{"operationId":"sendLines","requestBody":{"required":true,"content":{"application/jsonl":{"itemSchema":{"type":"integer"}}}},"responses":{"204":{}}}},
    "/send-events":{"post":{"operationId":"sendEvents","requestBody":{"required":true,"content":{"text/event-stream":{"itemSchema":{"$ref":"#/components/schemas/Event"}}}},"responses":{"204":{}}}},
    "/parts":{"post":{"operationId":"positional","requestBody":{"required":true,"content":{"multipart/mixed":{"schema":{"type":"array","minItems":1,"maxItems":3,"prefixItems":[{"type":"string"}],"items":{"type":"object","required":["n"],"properties":{"n":{"type":"integer"}},"additionalProperties":false}},"prefixEncoding":[{"contentType":"text/plain"}],"itemEncoding":{"contentType":"application/json","headers":{"X-Order":{"required":true,"schema":{"type":"integer"}}}}}}},"responses":{"204":{}}}}
  }
}
