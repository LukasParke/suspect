      "cookieKey":{"type":"apiKey","in":"cookie","name":"session_key"},
      "oauth":{"type":"oauth2","oauth2MetadataUrl":"https://auth.example.test/metadata","flows":{"authorizationCode":{"authorizationUrl":"https://auth.example.test/authorize","tokenUrl":"https://auth.example.test/token","refreshUrl":"https://auth.example.test/refresh","scopes":{"read:items":"Read items"}}}},
      "oidc":{"type":"openIdConnect","openIdConnectUrl":"https://auth.example.test/.well-known/openid-configuration"}
