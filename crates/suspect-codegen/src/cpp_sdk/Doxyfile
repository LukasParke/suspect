PROJECT_NAME = "@PACKAGE@"
PROJECT_NUMBER = "@VERSION@"
OUTPUT_DIRECTORY = "@CMAKE_CURRENT_BINARY_DIR@/docs"
INPUT = "@CMAKE_CURRENT_SOURCE_DIR@/include" "@CMAKE_CURRENT_SOURCE_DIR@/README.md" "@CMAKE_CURRENT_SOURCE_DIR@/docs/reference.md"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/README.md"
RECURSIVE = YES
FILE_PATTERNS = *.hpp *.md
EXTRACT_ALL = YES
EXTRACT_PRIVATE = NO
EXCLUDE_SYMBOLS = @NAMESPACE@::detail
GENERATE_HTML = YES
SHORT_NAMES = YES
GENERATE_XML = YES
GENERATE_LATEX = NO
HAVE_DOT = NO
WARN_AS_ERROR = FAIL_ON_WARNINGS
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = NO
QUIET = YES
JAVADOC_AUTOBRIEF = YES
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
PREDEFINED = @PACKAGE@_HAS_CURL=1
MARKDOWN_SUPPORT = YES
