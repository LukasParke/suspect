              "shortDescription": {
                "text": "Operations should document rate limiting — a 429 response or rate-limit headers."
              }
            },
            {
              "help": {
                "text": "Declare every `{var}` in the path as an `in: path` parameter on the path item or operation."
              },
              "id": "oas-path-param-not-declared",
              "shortDescription": {
                "text": "Path template variable without a declared parameter"
              }
            },
            {
              "id": "path-params",
              "shortDescription": {
                "text": "Path template variables must be declared as path parameters."
              }
            }
          ]
        }
