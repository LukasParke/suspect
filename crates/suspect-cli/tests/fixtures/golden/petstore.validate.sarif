          "ruleIndex": 1
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/LukasParke/suspect",
          "name": "suspect",
          "rules": [
            {
              "help": {
                "text": "Add an `operationId` so generated SDK methods carry a stable name."
              },
              "id": "oas-operation-missing-operationId",
              "shortDescription": {
                "text": "Operation without an operationId"
              }
            },
            {
              "help": {
                "text": "Add a `default` response or a 4XX/5XX response so client error handling is predictable."
              },
              "id": "oas-operation-no-error-response",
              "shortDescription": {
                "text": "Operation without an error response"
              }
            },
            {
              "help": {
                "text": "Declare every `{var}` in the path as an `in: path` parameter on the path item or operation."
              },
              "id": "oas-path-param-not-declared",
              "shortDescription": {
                "text": "Path template variable without a declared parameter"
              }
            }
          ]
        }
      }
    }
  ],
  "version": "2.1.0"
